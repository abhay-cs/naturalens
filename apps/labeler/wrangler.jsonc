{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naturalens-labeler",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "skim.naturalens.ca",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "vars": {
    "AUTH_MODE": "pin",
    "PIN_AUTH_EMAILS": "cdkitmail@gmail.com,abhay.msgs@gmail.com",
    "PIN_AUTH_MAX_ATTEMPTS": "4",
    "PIN_AUTH_LOCK_MINUTES": "30",
    "R2_CAP_STORAGE_BYTES": "8589934592",
    "R2_CAP_CLASS_A_MONTH": "800000",
    "R2_CAP_CLASS_B_MONTH": "8000000",
    "R2_CAP_MAX_OBJECT_BYTES": "20971520"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naturalens-labels",
      "database_id": "2fe255ec-de36-4899-9443-9b651612773d",
      "migrations_dir": "migrations"
    },
    {
      "binding": "WAITLIST_DB",
      "database_name": "naturalens-waitlist",
      "database_id": "5d04113a-851b-485c-a0e9-0d4ccb02cd07"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "naturalens-data"
    }
  ]
}
