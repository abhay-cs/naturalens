# Gemini API key — get a free one at https://aistudio.google.com/apikey (no credit card needed).
# Copy this file to .env and paste your key in. .env is gitignored.
#
# EXPO_PUBLIC_* vars are inlined into the app bundle, so treat this key as public:
# restrict it in AI Studio rather than relying on it staying secret.
EXPO_PUBLIC_GEMINI_API_KEY=
