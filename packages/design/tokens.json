{
  "meta": {
    "name": "Naturalens Design System",
    "version": "1.0.0",
    "description": "Volume One — black and white only. Depth via contrast, weight, and space."
  },
  "color": {
    "default": {
      "bg": "#FFFFFF",
      "fg": "#000000",
      "muted": "#666666",
      "caption": "#999999",
      "border": "#E5E5E5",
      "surface": "#F5F5F5"
    },
    "inverted": {
      "bg": "#000000",
      "fg": "#FFFFFF",
      "muted": "#999999",
      "caption": "#666666",
      "border": "#222222",
      "surface": "#111111"
    }
  },
  "typography": {
    "families": {
      "display": "Outfit",
      "body": "Archivo"
    },
    "ramp": {
      "display": {
        "family": "display",
        "weight": 200,
        "size": { "min": 46, "max": 104 },
        "lineHeight": 1.02,
        "letterSpacing": -0.03
      },
      "h1": {
        "family": "display",
        "weight": 300,
        "size": { "min": 34, "max": 56 },
        "lineHeight": 1.08,
        "letterSpacing": -0.025
      },
      "h2": {
        "family": "display",
        "weight": 400,
        "size": { "min": 28, "max": 36 },
        "lineHeight": 1.15,
        "letterSpacing": -0.015
      },
      "h3": {
        "family": "body",
        "weight": 600,
        "size": { "min": 18, "max": 20 },
        "lineHeight": 1.3,
        "letterSpacing": -0.005
      },
      "body": {
        "family": "body",
        "weight": 400,
        "size": { "min": 16, "max": 17 },
        "lineHeight": 1.65,
        "letterSpacing": 0
      },
      "small": {
        "family": "body",
        "weight": 400,
        "size": { "min": 14, "max": 14 },
        "lineHeight": 1.6,
        "letterSpacing": 0
      },
      "label": {
        "family": "body",
        "weight": 500,
        "size": { "min": 11, "max": 12 },
        "lineHeight": 1.4,
        "letterSpacing": 0.14,
        "transform": "uppercase"
      },
      "button": {
        "family": "body",
        "weight": 500,
        "size": { "min": 15, "max": 15 },
        "lineHeight": 1,
        "letterSpacing": 0.02
      }
    }
  },
  "space": {
    "hairline": 4,
    "xs": 8,
    "s": 16,
    "m": 24,
    "l": 40,
    "xl": 64,
    "xxl": 96,
    "xxxl": 160
  },
  "radius": {
    "media": 0,
    "input": 2,
    "panel": 8,
    "cta": 999
  },
  "motion": {
    "enter": 480,
    "state": 220,
    "stagger": 60,
    "rise": 8,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "focus": {
    "width": 2,
    "offset": 3
  }
}
